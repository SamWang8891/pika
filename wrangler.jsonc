{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pika",
  "compatibility_date": "2025-08-03",
  "main": "./src/server/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything through the worker (API + short-link redirects) except built
    // assets and the public/ files — short keys are dot-free [A-Za-z0-9]+, so
    // anything with an extension can be served straight from the asset layer.
    "run_worker_first": ["/*", "!/assets/*", "!/*.png", "!/*.svg", "!/*.ico", "!/site.webmanifest"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pika",
      "database_id": "REPLACE_WITH_wrangler_d1_create_pika_OUTPUT",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
