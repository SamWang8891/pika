{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pika",
  "compatibility_date": "2025-08-03",
  "main": "./src/server/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything through the worker (API + short-link redirects) except built
    // assets and the public/ files. Extension globs like !/*.svg compile to `.*`
    // and span path segments (so /api/x.svg would bypass the worker), so the
    // public/ files are excluded by exact path instead.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/favicon.ico",
      "!/favicon-16x16.png",
      "!/favicon-32x32.png",
      "!/apple-touch-icon.png",
      "!/android-chrome-192x192.png",
      "!/android-chrome-512x512.png",
      "!/icon-QR.png",
      "!/Pika-full-logo.svg",
      "!/site.webmanifest"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pika",
      "database_id": "REPLACE_WITH_wrangler_d1_create_pika_OUTPUT",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
