# Comma-separated allowed CORS origins, e.g. https://pika.example.com
# Do NOT use "*" here: with credentials enabled Starlette reflects the caller's
# Origin, so a wildcard lets any site make credentialed requests. setup.sh fills
# this in with your real base URL.
ALLOWED_ORIGINS=http://localhost:5173

# You can generate the following by running `openssl rand -hex 64`
SECRET_KEY=

# You can generate the following by running `openssl rand -hex 16`
BEARER_TOKEN=

# Session cookie hardening. Set both to true/none when the frontend and backend
# are on different origins served over HTTPS (cross-site cookies need Secure + SameSite=none).
SESSION_HTTPS_ONLY=false
SESSION_SAME_SITE=lax